{
	"name": "ephemeral-events-web",
	"private": true,
	"version": "0.1.0",
	"license": "AGPL-3.0-or-later",
	"repository": {
		"type": "git",
		"url": "https://github.com/ephemeral-social/events.git"
	},
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint . && prettier --check .",
		"format": "prettier --write .",
		"test": "vitest --run",
		"test:watch": "vitest",
		"test:unit": "vitest --run src/test/unit",
		"test:integration": "vitest --run src/test/integration",
		"test:api": "vitest --run src/test/api",
		"test:pages": "vitest --run src/test/pages",
		"test:e2e": "vitest --run --config vitest.config.e2e.ts src/test/e2e",
		"test:pw": "npx playwright test",
		"test:pw:ui": "npx playwright test --ui",
		"test:pw:mobile": "npx playwright test --project=mobile-chrome",
		"test:pw:visual": "npx playwright test --project=visual",
		"test:pw:update-snapshots": "npx playwright test --project=visual --update-snapshots"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20260218.0",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.58.2",
		"@sveltejs/adapter-cloudflare": "^6.0.0",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.0.0",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.3.1",
		"@types/qrcode": "^1.5.6",
		"eslint": "^10.0.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.15.0",
		"globals": "^17.3.0",
		"jsdom": "^28.1.0",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.4.1",
		"svelte": "^5.49.2",
		"svelte-check": "^4.3.6",
		"tailwindcss": "^4.0.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.56.0",
		"vite": "^7.3.1",
		"vitest": "^4.0.18"
	},
	"dependencies": {
		"@formkit/auto-animate": "^0.9.0",
		"@stripe/connect-js": "^3.3.34",
		"@stripe/stripe-js": "^8.8.0",
		"bits-ui": "^1.0.0",
		"clsx": "^2.1.0",
		"culori": "^4.0.2",
		"dompurify": "^3.3.1",
		"html5-qrcode": "^2.3.8",
		"ios-haptics": "^0.1.4",
		"motion": "^12.38.0",
		"phosphor-svelte": "^2.0.0",
		"qrcode": "^1.5.4",
		"tailwind-merge": "^3.0.0",
		"tailwind-variants": "^1.0.0"
	}
}
